{
  "name": "BurstWord.Samples",
  "rootNamespace": "BurstWord",
  "references": [
    "BurstWord.Runtime",
    "Unity.TextMeshPro",
    "UnityEngine.UI"
  ],
  "defineConstraints": [
    "BURSTWORD_TMP || BURSTWORD_UGUI_TMP"
  ],
  "versionDefines": [
    {
      "name": "com.unity.textmeshpro",
      "expression": "3.0.0",
      "define": "BURSTWORD_TMP"
    },
    {
      "name": "com.unity.ugui",
      "expression": "2.0.0",
      "define": "BURSTWORD_UGUI_TMP"
    }
  ]
}
